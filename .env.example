# =============================================================================
# EEH2 Pipeline Configuration
# =============================================================================
# Copy this file to .env and fill in the paths for your system.
#
#   cp .env.example .env
#
# Quick start with sample data:
#
#   uv run python download_sample.py          # downloads to ./data/
#   uv run python run_pipeline.py             # runs the full pipeline
#
# Docker:
#
#   cp rttov123.tar.gz .                      # place RTTOV tarball in repo root
#   docker compose up --build                 # builds image and runs pipeline
#
# Individual steps:
#
#   uv run python TES/TES_main.py  --help
#   uv run python STIC/STIC_main.py --help
#   uv run python GPP/GPP_main.py  --help
# =============================================================================

# --- Credentials (for download_sample.py) ---
# NASA Earthdata (https://urs.earthdata.nasa.gov/)
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
# Copernicus CDS API (https://cds.climate.copernicus.eu/how-to-api)
CDS_API_URL=https://cds.climate.copernicus.eu/api
CDS_API_KEY=
# Copernicus Data Space — CDSE (https://dataspace.copernicus.eu/)
# Needed for FCOVER + LAI download
CDSE_USERNAME=
CDSE_PASSWORD=
# EUMETSAT Data Store (https://data.eumetsat.int/) — for PAR download
# Generate keys at: https://api.eumetsat.int/api-key/
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=
# S3-compatible storage (optional — alternative to downloading from original sources)
# If set, download_sample.py --from-s3 syncs data from this bucket first
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=ECOSTRESS
# S3 prefix overrides (optional — change if your bucket uses different directory names)
# S3_PREFIX_RAD=L1B_RAD_V002
# S3_PREFIX_GEO=L1B_GEO_V002
# S3_PREFIX_CLOUD=L2_CLOUD_V002
# S3_PREFIX_ERA5=ERA5
# S3_PREFIX_MOTA=MOTA
# S3_PREFIX_FCOVER=FCOVER
# S3_PREFIX_LAI=LAI
# S3_PREFIX_LULC=LULC
# S3_PREFIX_OCO2=OCO2
# S3_PREFIX_GLC30=GLC_FCS30D
# S3_PREFIX_PARH=PARH

# --- Which pipeline steps to run (true / false) ---
RUN_TES=true
RUN_STIC=true
RUN_GPP=true

# --- Docker mount roots ---
# What docker-compose.yml bind-mounts on /data and /output. Set DATA_ROOT when
# the data lives outside the repository (another disk, a mounted volume); the
# paths below are not consulted by the container, which always reads /data.
DATA_ROOT=./data
OUTPUT_ROOT=./output

# --- Input data directories (runs without Docker) ---
# (If you ran download_sample.py with --output-dir ./data, use these defaults)
# ECOSTRESS L1B radiance files (.h5)
INPUT_RAD_DIR=./data/rad
# ECOSTRESS L1B geolocation files (.h5)
GEO_DIR=./data/geo
# ECOSTRESS L2 cloud mask files (.h5)
CLOUD_DIR=./data/cloud
# ERA5 reanalysis GRIB files
ERA5_DIR=./data/era5

# --- TES-specific ---
# RTTOV installation root (contains rtcoef_rttov12/, wrapper/, ...)
# Docker default: /opt/rttov123
RTTOV_INSTALLDIR=/opt/rttov123
# Optional: override RTTOV wrapper/coef paths (leave empty for defaults)
RTTOV_WRAPPER_DIR=
RTTOV_COEF_FILE=
RTTOV_LIB_PRELOAD=

# --- STIC-specific ---
# CGLS FCOVER .nc files (300 m, 10-day)
FCOVER_DIR=./data/fcover
# MCD43C3 MODIS albedo .hdf files
ALBEDO_MOTA_DIR=./data/mota
# Copernicus PROBAV LC100 land-cover directory
LULC_DIR=./data/lulc

# --- GPP-specific ---
# Half-hourly PAR (PARin) files
PARH_DIR=./data/parh
# LAI 300 m 10-day files
LAI_DIR=./data/lai
# FCOVER 300 m 10-day files (may be the same as FCOVER_DIR)
FVC_DIR=./data/fcover
# OCO-2 XCO2 files
OCO2_DIR=./data/oco2
# GLC30 land-cover tiles
GLC30_DIR=./data/glc30
# LUT CSV (shipped with this repository)
LUT_FILE=GPP/LookUpTable_LUE_HH_gsFULL-globe.csv

# --- Output directories (runs without Docker) ---
# These are run_pipeline.py's own defaults. Under Docker the container writes to
# /output/tes|stic|gpp, i.e. inside OUTPUT_ROOT above.
OUTPUT_TES=./data/output/tes
OUTPUT_STIC=./data/output/stic
OUTPUT_GPP=./data/output/gpp

# Processing domain as "N,W,S,E". ERA5 is requested over this box and
# ECOSTRESS granules outside it are neither downloaded nor processed.
# Default: Europe and Africa.
# EEH2_DOMAIN=75,-20,-35,60
